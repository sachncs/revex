# revex — local-first development env.
#
# Copy to `.env` and fill in your real values. Real keys must NEVER
# be committed. The Settings loader (loadSettings in @revex/core)
# reads every REVEX_* key below; unknown REVEX_* keys produce a
# warning, not an error.

# Auth — JWT (HS256) and tenant secret key (AES-256-GCM).
# The JWT secret MUST be at least 32 characters; the runtime guard
# throws ConfigurationError otherwise. Generate one with:
#     openssl rand -base64 48
# Generate the tenant secret key (32 bytes, hex-encoded = 64 chars) with:
#     openssl rand -hex 32
REVEX_JWT_SECRET=
REVEX_TENANT_SECRETS_KEY=

# Embedder + LLM.
OPENAI_API_KEY=
REVEX_EMBEDDER_PROVIDER=openai
REVEX_EMBEDDER_MODEL=text-embedding-3-large
REVEX_LLM_PROVIDER=openai
REVEX_LLM_MODEL=gpt-4.1

# Vector store (sqlite-vec only).
REVEX_VECTOR_BACKEND=sqlite_vec
REVEX_VECTOR_PATH=./.revex/revex.db
REVEX_VECTOR_EMBEDDING_DIM=3072

# Orchestrator (mode / ordering / k / reranker).
REVEX_ORCHESTRATOR_MODE=graph
REVEX_ORCHESTRATOR_ORDERING=standard
REVEX_ORCHESTRATOR_TOP_K=10
REVEX_ORCHESTRATOR_RERANKER=identity

# Hybrid retrieval (RRF).
REVEX_HYBRID_DENSE_WEIGHT=0.6
REVEX_HYBRID_SPARSE_WEIGHT=0.4
REVEX_HYBRID_RRF_K=60
REVEX_HYBRID_COLBERT=false

# Telemetry (noop | langfuse | otel).
REVEX_TELEMETRY_PROVIDER=noop
REVEX_LANGFUSE_PUBLIC_KEY=
REVEX_LANGFUSE_SECRET_KEY=
REVEX_OTEL_ENDPOINT=

# Web → API base URL.
REVEX_API_BASE=http://localhost:3000

# Production hardening. The headers below apply when REVEX_PROFILE
# is set to "production" (or NODE_ENV=production).
#
# REVEX_PROFILE: enables Strict-Transport-Security and rejects
#     wildcard CORS at boot.
# REVEX_CORS_ORIGINS: comma-separated allowlist of frontend origins
#     for CORS / CSRF. Must not include "*" in production.
# REVEX_CSP: the Content-Security-Policy header value. A safe
#     default for the app shell is:
#         default-src 'self'; img-src 'self' data:; connect-src 'self'; frame-ancestors 'none'
# REVEX_TRUSTED_PROXY_CIDRS: comma-separated list of reverse-proxy
#     CIDRs. The rate limiter honours X-Forwarded-For only when the
#     immediate socket peer matches one of these.
REVEX_PROFILE=development
REVEX_CORS_ORIGINS=http://localhost:3001,http://127.0.0.1:3001
REVEX_CSP=default-src 'self'; img-src 'self' data:; connect-src 'self'; frame-ancestors 'none'
REVEX_TRUSTED_PROXY_CIDRS=