{
  "name": "revex",
  "version": "1.1.0",
  "private": true,
  "description": "Revex — hybrid retrieval for teams. Vector, keyword, graph, memory, web — one engine.",
  "type": "module",
  "engines": {
    "node": ">=26",
    "pnpm": ">=9"
  },
  "packageManager": "pnpm@9.12.3",
  "volta": {
    "node": "26.7.0"
  },
  "scripts": {
    "build": "turbo run build",
    "dev": "turbo run dev --parallel",
    "lint": "turbo run lint",
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "typecheck": "turbo run typecheck",
    "test": "turbo run test",
    "test:watch": "turbo run test -- --watch",
    "e2e": "echo \"No E2E harness is configured yet. Run 'pnpm test' for the unit + integration suites, or boot @revex/api + @revex/web locally and visit http://localhost:3001.\" && exit 0",
    "clean": "turbo run clean && rm -rf node_modules"
  },
  "devDependencies": {
    "@eslint/js": "^9.39.1",
    "@types/node": "^26.0.0",
    "eslint": "^9.39.1",
    "prettier": "^3.3.3",
    "turbo": "^2.3.0",
    "typescript": "^5.6.3",
    "typescript-eslint": "^8.18.0"
  },
  "dependencies": {
    "better-sqlite3": "^12"
  }
}
